# Weights & Biases Configuration for nnU-Net
# Copy this file to '.env' and fill in your WANDB_API_KEY.
# DO NOT commit '.env' to git! It is ignored by default in .gitignore.

# Enable W&B integration in nnU-Net logger (True or 1 to enable, False or 0 to disable)
nnUNet_wandb_enabled=True

# W&B project name (defaults to "nnunet" if not set)
nnUNet_wandb_project=brain-mets-segmentation

# W&B mode: "online" (upload immediately) or "offline" (save locally, upload later)
nnUNet_wandb_mode=online

# Your personal W&B API authorization key.
# Get yours from: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# Optional: Custom run name, tags, and run group if desired
# WANDB_NAME=mets-custom-run
# WANDB_GROUP=resenc_mets
# WANDB_TAGS=mets,residual_encoder
